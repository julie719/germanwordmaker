{
  "rewrites": [
    { "source": "/word/:slug", "destination": "/api/page?slug=:slug" }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "word.html" },
    "api/og.js": { "includeFiles": "api/_fonts/**" }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
