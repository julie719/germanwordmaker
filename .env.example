# Copy to .env for `vercel dev`. Everything below runs locally in Docker (npm run db:up).

# Mock Anthropic + ElevenLabs (dev/mock-ai.mjs). To use the real APIs, delete
# these two lines and fill in the keys with your own, not production's.
ANTHROPIC_BASE_URL=http://localhost:8081
ELEVENLABS_BASE_URL=http://localhost:8081
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Local Redis
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local-dev-token

# Password for /api/export?key=…
EXPORT_KEY=local-export-key
